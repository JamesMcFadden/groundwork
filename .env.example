# Copy to .env and adjust. .env is gitignored — never commit real credentials.
# POSTGRES_PASSWORD and S3_SECRET_KEY have no defaults in code: the application
# refuses to start without them rather than falling back to a weak value.

# PostgreSQL
POSTGRES_USER=groundwork
POSTGRES_PASSWORD=change-me
POSTGRES_DB=groundwork
POSTGRES_PORT=5432

# Object storage. MinIO locally, real S3 in AWS.
# Host-side tools use localhost; containers on the compose network use
# http://minio:9000 and are overridden in docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=groundwork-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me

# Answer generation. GENERATOR defaults to anthropic, which needs a key: the API refuses
# to start without one rather than serve fake answers. GENERATOR=stub answers from the
# top retrieved passage with no model call, for load tests and working offline.
# `make eval-live` also reads this key, whatever GENERATOR says; `make eval` needs none.
ANTHROPIC_API_KEY=
# GENERATOR=stub

# Retrieval. RETRIEVER defaults to hybrid, fusing search by embedding with full-text
# search; dense searches by embedding alone.
# RETRIEVER=dense
