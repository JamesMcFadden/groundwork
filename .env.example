# Copy to .env and adjust. .env is gitignored — never commit real credentials.
# POSTGRES_PASSWORD, S3_ACCESS_KEY, and S3_SECRET_KEY have no defaults in code: the
# application refuses to start without them rather than falling back to a weak value.

# PostgreSQL
POSTGRES_USER=groundwork
POSTGRES_PASSWORD=change-me
POSTGRES_DB=groundwork
POSTGRES_PORT=5432

# Object storage. MinIO locally, real S3 in AWS.
# Host-side tools use localhost; containers on the compose network use
# http://minio:9000 and are overridden in docker-compose.yml. The keys are required whenever
# S3_ENDPOINT is set; on AWS the endpoint is empty and both keys are left unset, so the
# client takes credentials from the pod's IAM role.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=groundwork-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me

# API. Clients send this key in the X-API-Key header on every route but /health, and the
# API refuses to start without it. The worker and the eval harness do not read it.
API_KEY=change-me

# Answer generation. The stub answers from the top retrieved passage with no model call, so
# a fresh clone comes up and answers questions without a paid key. For real answers, put a
# key in ANTHROPIC_API_KEY and comment GENERATOR out: the code's own default is anthropic,
# which refuses to start without a key rather than serve fake answers. Only this example
# file chooses the stub, so a deployment that sets nothing still fails loudly.
# `make eval-live` reads the key whatever GENERATOR says; `make eval` needs none.
ANTHROPIC_API_KEY=
GENERATOR=stub

# Retrieval. RETRIEVER defaults to hybrid, fusing search by embedding with full-text
# search; dense searches by embedding alone.
# RETRIEVER=dense
