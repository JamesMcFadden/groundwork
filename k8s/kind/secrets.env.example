# Copy to k8s/kind/secrets.env, which is gitignored, and replace every value; `openssl rand -hex 32`
# makes one. `kubectl apply -k k8s/kind` reads the file into the groundwork-secrets Secret.
POSTGRES_PASSWORD=change-me
S3_SECRET_KEY=change-me
# The key every client sends in X-API-Key, load tests included.
API_KEY=change-me
